{
  "name": "aijobsmarket",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "build:worker": "opennextjs-cloudflare build --skipNextBuild",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aijobsmarket_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply aijobsmarket_db --remote",
    "db:seed:local": "tsx src/db/seed.ts --local",
    "db:seed:remote": "tsx src/db/seed.ts --remote",
    "db:seed:tasks:local": "tsx src/db/seed-tasks.ts --local",
    "db:seed:tasks:remote": "tsx src/db/seed-tasks.ts --remote",
    "db:cleanup:local": "tsx src/db/cleanup-user-content.ts --local",
    "db:cleanup:remote": "tsx src/db/cleanup-user-content.ts --remote",
    "db:studio": "drizzle-kit studio",
    "pages:build": "npm run build",
    "pages:deploy": "npm run build && opennextjs-cloudflare deploy",
    "pages:preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy -- --keep-vars",
    "secret:put": "wrangler versions secret put CLERK_SECRET_KEY",
    "secret:put:webhook": "wrangler versions secret put CLERK_WEBHOOK_SIGNING_SECRET",
    "secret:list": "wrangler versions secret list"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.8",
    "@marsidev/react-turnstile": "^1.5.3",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "lucide-react": "^1.21.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.14.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@opennextjs/cloudflare": "^1.2.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.5.2",
    "drizzle-kit": "^0.31.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.3"
  }
}
