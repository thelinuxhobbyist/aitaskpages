# Copy to .env.local for `next dev`
#
# Clerk: use the Development instance keys (pk_test_… / sk_test_…).
# Production (pk_live_) keys only work on aijobsmarket.co.uk and will fail on localhost.
# Dashboard → switch to Development → API Keys
# https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Resend (https://resend.com)
RESEND_API_KEY=

# Cloudflare (for drizzle-kit remote ops — optional)
CLOUDFLARE_ACCOUNT_ID=2c9fa9806d36682d8166c2b25c3ec166
CLOUDFLARE_D1_DATABASE_ID=3f306411-f30c-4593-8cc4-37f798e752e5
# CLOUDFLARE_API_TOKEN=

# Cloudflare Turnstile (optional — https://dash.cloudflare.com/?to=/:account/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
