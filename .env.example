# Copy to .env.local for `next dev`
#
# Clerk: create a NEW Clerk application for AI Task Pages (do not reuse AI Jobs Market).
# Use Development instance keys (pk_test_… / sk_test_…) for local work.
# Dashboard → switch to Development → API Keys
# https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Required when middleware passes Clerk keys dynamically (Cloudflare Workers).
# Generate with: openssl rand -hex 32
CLERK_ENCRYPTION_KEY=

# Resend (https://resend.com) — use a separate API key / domain for AI Task Pages
RESEND_API_KEY=
EMAIL_FROM="AI Task Pages <notify@aitaskpages.com>"
MARKETING_EMAIL_FROM="AI Task Pages <notify@aitaskpages.com>"

# Cloudflare (for drizzle-kit remote ops — optional)
# Account may be shared; D1 ID must be aitaskpages_db only (never aijobsmarket_db)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=cce6e833-e0d6-4e52-968d-c4363a5b741f
# CLOUDFLARE_API_TOKEN=

# Cloudflare Turnstile (optional — https://dash.cloudflare.com/?to=/:account/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Coming-soon cover (production wrangler [vars]; leave unset for local `next dev`)
# COMING_SOON=1
# COMING_SOON_BYPASS=your-preview-token
